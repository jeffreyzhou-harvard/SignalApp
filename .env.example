# ─────────────── Frontend (Next.js app, repo root) ───────────────
# xAI — required for chat + image generation
XAI_API_KEY=

# Provider selection (pluggable — see src/lib/providers/registry.ts)
AI_TEXT_PROVIDER=grok
AI_IMAGE_PROVIDER=grok-imagine

# Model overrides (optional)
XAI_TEXT_MODEL=grok-4.5
XAI_IMAGE_MODEL=grok-imagine-image-quality
XAI_VIDEO_MODEL=grok-imagine-video-1.5

# Video provider (pluggable — see src/lib/providers/registry.ts)
AI_VIDEO_PROVIDER=grok-imagine-video

# Storage adapter (pluggable — see src/lib/storage/index.ts)
STORAGE_ADAPTER=json

# Sign in with X (OAuth 2.0 + PKCE). Setting X_OAUTH_CLIENT_ID switches account
# linking from the local stub to the real redirect flow automatically.
# Portal: User authentication settings → Web App → callback <origin>/api/auth/x/callback
X_OAUTH_CLIENT_ID=
# Only for confidential clients; leave empty for public (PKCE-only) clients
X_OAUTH_CLIENT_SECRET=
# Optional override; defaults to <origin>/api/auth/x/callback
X_OAUTH_REDIRECT_URI=
# Force a specific account provider (x-stub | x-oauth); default is automatic
ACCOUNT_PROVIDER=

# Audience data (pluggable — see src/lib/audience/registry.ts; "mock" = seeded sample tribes)
AUDIENCE_PROVIDER=mock

# Wind-tunnel simulation (pluggable — see src/lib/simulation/registry.ts; "mock-agents" = seeded sample loop)
SIMULATION_PROVIDER=mock-agents

# ─────────────── Backend (data ingestion, /backend) ───────────────
# X platform read path — app-only bearer works for user lookup, followers, timelines.
# (Co-engagement likers/retweeters need OAuth user-context; degrades gracefully without it.)
X_AI_CONSUMER_KEY=
X_AI_SECRET_KEY=
X_AI_BEARER_TOKEN=
# Grok summarization key — accepted as X_AI_API_KEY or XAI_API_KEY
X_AI_API_KEY=
# Postgres: local docker OR shared Neon (postgresql+psycopg://USER:PASS@HOST/db?sslmode=require)
DATABASE_URL=postgresql+psycopg://agentsim:agentsim@localhost:5432/agentsim
# Budget guard (USD)
X_API_BUDGET_USD=250
X_API_SPEND_SOFT_LIMIT_USD=200
# Grok summarization client (model id is billing-sensitive — only grok-4.3 for v1)
GROK_MODEL=grok-4.3
GROK_BASE_URL=https://api.x.ai/v1
GROK_MAX_RETRIES=2
# API throttling / robustness
HTTP_TIMEOUT_S=30
WORKER_POLL_INTERVAL_S=1.0
FOLLOWERS_PAGE_SIZE=1000
SEED_POSTS_LOOKBACK=25
ENRICH_CONCURRENCY=8          # parallel Grok persona-card calls during tier-2 enrich
